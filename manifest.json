{
  "manifest_version": 3,
  "name": "Copy Image as WebP",
  "version": "1.0.0",
  "description": "Right-click any image and copy it directly to your clipboard in WebP format without downloading.",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Copy Image as WebP Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
